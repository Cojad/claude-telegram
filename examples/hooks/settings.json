{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "/absolute/path/to/.claude/hooks/tg-progress-start.sh", "timeout": 12 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "/absolute/path/to/.claude/hooks/tg-progress-append.sh pre", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "/absolute/path/to/.claude/hooks/tg-progress-append.sh post", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/absolute/path/to/.claude/hooks/tg-progress-stop.sh", "timeout": 10 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "/absolute/path/to/.claude/hooks/tg-progress-compact.sh pre", "timeout": 10 }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          { "type": "command", "command": "/absolute/path/to/.claude/hooks/tg-progress-compact.sh post", "timeout": 10 }
        ]
      }
    ]
  }
}
